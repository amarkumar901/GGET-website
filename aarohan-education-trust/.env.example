# Copy to `.env` if you want to override defaults.
# Local preview works with none of these set (embedded database + demo checkout).

# Postgres. Leave unset to use the built-in local database.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/aarohan

# Razorpay — only when you want real or test payments.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Email — optional. Failed email never marks a paid donation as failed.
# RESEND_API_KEY=
# EMAIL_FROM=Aarohan <hello@yourdomain.org>
# ADMIN_NOTIFICATION_EMAIL=

# Auth — optional locally. First person to sign in at /login becomes admin.
# BETTER_AUTH_URL=http://localhost:8080
# BETTER_AUTH_SECRET=
